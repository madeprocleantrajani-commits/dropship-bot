# ============================================
# Dropship Bot — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env

# === Telegram Alerts ===
# Get your bot token from @BotFather on Telegram.
# Get your chat ID by messaging @userinfobot on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === Proxy (Optional but recommended) ===
# Without a proxy, Google Trends and AliExpress will block you quickly.
# Residential proxies work best. Leave empty to connect directly.
# Formats:
#   http://user:pass@proxy.example.com:8080
#   socks5://user:pass@proxy.example.com:1080
PROXY_URL=

# === Currency Conversion ===
# Your VPS may return EUR prices from Amazon (e.g. Ireland servers).
# Set the EUR→USD rate for margin calculations.
EUR_TO_USD=1.08
